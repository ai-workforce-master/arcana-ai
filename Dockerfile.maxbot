FROM golang:1.25-alpine AS builder

RUN apk add --no-cache git

WORKDIR /app

COPY go.mod go.sum* ./
COPY . .

RUN go mod tidy && go mod download

RUN CGO_ENABLED=0 GOOS=linux go build -a -installsuffix cgo -o maxbot ./cmd/maxbot/main.go

FROM alpine:latest

WORKDIR /root/

COPY --from=builder /app/maxbot .

CMD ["./maxbot"]
