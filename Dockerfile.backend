# Этап сборки
FROM golang:1.23-alpine AS builder

WORKDIR /app

# 1. Копируем go.mod (и go.sum, если он вдруг остался)
COPY go.mod go.sum* ./

# 2. Копируем ВЕСЬ исходный код СРАЗУ
COPY . .

# 3. Синхронизируем зависимости на основе реального кода и скачиваем их.
# Теперь это сработает корректно, так как код уже скопирован и не перезапишет результат.
RUN go mod tidy && go mod download

# 4. Собираем бинарный файл
RUN CGO_ENABLED=0 GOOS=linux go build -a -installsuffix cgo -o main ./cmd/api/main.go

# Финальный этап
FROM alpine:latest

WORKDIR /root/

COPY --from=builder /app/main .

EXPOSE 8080

CMD ["./main"]
