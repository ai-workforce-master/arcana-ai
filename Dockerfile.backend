# Этап сборки
FROM golang:1.23-alpine AS builder

WORKDIR /app

# 1. Копируем go.mod (даже если он "грязный")
COPY go.mod ./

# 2. ЯВНО и принудительно фиксируем нужную версию ПЕРЕД запуском go mod tidy.
# Это перезапишет любые попытки авто-обновления внутри контейнера.
RUN go get github.com/qdrant/go-client@v1.9.0

# 3. Синхронизируем остальные зависимости и скачиваем их
RUN go mod tidy && go mod download

# 4. Копируем исходный код
COPY . .

# 5. Собираем бинарный файл
RUN CGO_ENABLED=0 GOOS=linux go build -a -installsuffix cgo -o main ./cmd/api/main.go

# Финальный этап
FROM alpine:latest

WORKDIR /root/

COPY --from=builder /app/main .

EXPOSE 8080

CMD ["./main"]
