FROM golang:1.24-alpine AS builder

RUN apk add --no-cache git

WORKDIR /app

COPY go.mod go.sum* ./

# ЖЕСТКО фиксируем версию клиента Qdrant, совместимую с сервером v1.7.0
# Это предотвращает автоматическое обновление до v1.18.3 с ломающими изменениями API
RUN go get github.com/qdrant/go-client@v1.12.0

COPY . .

RUN go mod tidy && go mod download

RUN CGO_ENABLED=0 GOOS=linux go build -a -installsuffix cgo -o main ./cmd/api/main.go

FROM alpine:latest

WORKDIR /root/

COPY --from=builder /app/main .

EXPOSE 8080

CMD ["./main"]
