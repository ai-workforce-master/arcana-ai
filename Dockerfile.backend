# Этап сборки
FROM golang:1.23-alpine AS builder

WORKDIR /app

# Копируем только go.mod (без go.sum, чтобы go mod tidy сгенерировал его заново на сервере)
COPY go.mod ./

# Синхронизируем зависимости и скачиваем их (это решит проблему недостающих модулей)
RUN go mod tidy && go mod download

# Копируем исходный код
COPY . .

# Собираем бинарный файл
RUN CGO_ENABLED=0 GOOS=linux go build -a -installsuffix cgo -o main ./cmd/api/main.go

# Финальный этап
FROM alpine:latest

WORKDIR /root/

# Копируем бинарный файл из этапа сборки
COPY --from=builder /app/main .

# Открываем порт
EXPOSE 8080

# Запускаем приложение
CMD ["./main"]
