# Этап сборки
FROM golang:1.23-alpine AS builder

# Устанавливаем git, который необходим для go mod tidy при скачивании некоторых модулей
RUN apk add --no-cache git

WORKDIR /app

# 1. Копируем go.mod (и go.sum, если он есть)
COPY go.mod go.sum* ./

# 2. Копируем ВЕСЬ исходный код проекта
COPY . .

# 3. Синхронизируем зависимости и скачиваем их
RUN go mod tidy && go mod download

# 4. Собираем бинарный файл
RUN CGO_ENABLED=0 GOOS=linux go build -a -installsuffix cgo -o main ./cmd/api/main.go

# Финальный этап
FROM alpine:latest

WORKDIR /root/

COPY --from=builder /app/main .

EXPOSE 8080

CMD ["./main"]
