# AI Provider (AITunnel)
AITUNNEL_API_KEY=your_aitunnel_api_key_here
AITUNNEL_BASE_URL=https://api.aitunnel.ru/v1/

# Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Payments (YooKassa Sandbox)
YOOKASSA_SHOP_ID=your_shop_id
YOOKASSA_SECRET_KEY=your_secret_key

# Security
MODERATION_SALT=generate_a_random_secure_string_here

# Infrastructure (Default values match docker-compose)
REDIS_URL=redis://redis:6379/0
POSTGRES_DSN=postgres://arcana:arcana_password@postgres:5432/arcana_db?sslmode=disable
QDRANT_URL=http://qdrant:6333
EMBEDDINGS_SVC_URL=http://embeddings-svc:8000
