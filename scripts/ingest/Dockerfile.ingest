FROM python:3.10-slim

WORKDIR /app

COPY requirements.txt .

# Увеличиваем таймаут до 1000 секунд и добавляем 10 попыток при обрыве связи
RUN pip install --no-cache-dir --default-timeout=1000 --retries 10 -r requirements.txt

COPY ingest_cards.py .

# Скрипт выполнится при запуске контейнера и завершит работу
CMD ["python", "ingest_cards.py"]
